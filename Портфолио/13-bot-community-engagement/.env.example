# --- Telegram ---------------------------------------------------------------
# Токен от @BotFather
BOT_TOKEN=123456:ABC-DEF_your_token_here

# ID администраторов бота через запятую (глобальные админы, помимо админов чата)
# Свой id можно узнать у @userinfobot
ADMIN_IDS=

# Язык по умолчанию для новых чатов: ru | en
DEFAULT_LANG=ru

# --- База данных ------------------------------------------------------------
# DB_ENGINE: sqlite (локально) | postgres (прод)
DB_ENGINE=sqlite

# Для sqlite:
DB_PATH=data/bot.db

# Для postgres:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=engagement
DB_USER=engagement
DB_PASSWORD=engagement

# --- Прочее -----------------------------------------------------------------
# Таймзона для планировщика (вопрос дня, недельный топ)
TZ=Europe/Amsterdam

# Уровень логов: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

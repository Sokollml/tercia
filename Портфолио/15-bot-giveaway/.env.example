# --- Telegram ---
# Token from @BotFather
BOT_TOKEN=123456:ABC-DEF_your_token_here
# Comma-separated Telegram user IDs allowed to run admin commands
ADMIN_IDS=111111111,222222222

# --- Database ---
# DB_ENGINE: sqlite (local dev) | postgres (production)
DB_ENGINE=sqlite

# SQLite: path to the database file
DB_PATH=giveaway.db

# PostgreSQL: either a full DSN...
# DB_ENGINE=postgres
# DB_DSN=postgresql://giveaway:giveaway@localhost:5432/giveaway
# ...or assembled from parts:
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=giveaway
# DB_USER=giveaway
# DB_PASSWORD=giveaway

# --- Behaviour ---
# Timezone for the scheduler (IANA name)
TZ=UTC
# Default interface language: ru | en
DEFAULT_LANG=ru
# Minimum seconds between actions per user (anti-spam)
RATE_LIMIT_SECONDS=0.7
# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

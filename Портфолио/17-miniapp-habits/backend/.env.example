# ─── Telegram ──────────────────────────────────────────────────────────────
# Токен бота из @BotFather. Используется для проверки подписи initData.
BOT_TOKEN=123456789:AA...replace_me...

# ─── Сервер ────────────────────────────────────────────────────────────────
PORT=8080
# URL фронтенда (mini-app) — для CORS. Через запятую можно несколько.
MINIAPP_URL=https://your-miniapp.vercel.app

# ─── База данных ───────────────────────────────────────────────────────────
# Драйвер: postgres (по умолчанию, целевой) или sqlite (локально/тесты).
DB_DRIVER=postgres

# Postgres. Можно задать одним DATABASE_URL ИЛИ по частям DB_* ниже.
DATABASE_URL=postgres://habits:habits@localhost:5432/habits
DB_HOST=localhost
DB_PORT=5432
DB_USER=habits
DB_PASSWORD=habits
DB_NAME=habits

# SQLite (если DB_DRIVER=sqlite). Путь к файлу или ":memory:".
SQLITE_PATH=./habits.sqlite

# ─── Безопасность ──────────────────────────────────────────────────────────
# Максимальный возраст initData в секундах (защита от replay). 0 = без проверки.
INITDATA_MAX_AGE_SEC=86400

# ============================================================================
#  Loyalty mini-app — example environment.
#  Copy to .env and fill in real values. NEVER commit the real .env.
# ============================================================================

# --- Telegram ---------------------------------------------------------------
# Bot token from @BotFather.
BOT_TOKEN=123456:ABC-DEF_your_bot_token_here

# Comma-separated Telegram user ids of cafe staff (admins).
# Find yours by messaging @userinfobot.
ADMIN_IDS=111111111,222222222

# Public HTTPS URL where the mini-app frontend is hosted (Vercel/Netlify/etc).
# Also used as the backend CORS origin.
MINIAPP_URL=https://your-miniapp.example.com

# --- Backend ----------------------------------------------------------------
PORT=3000
HOST=0.0.0.0

# How many stamps a customer collects before earning a reward.
STAMPS_PER_REWARD=8

# Reject initData older than this many seconds (replay protection).
INITDATA_MAX_AGE_SECONDS=86400

# --- Database (PostgreSQL) --------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=loyalty
DB_PASSWORD=loyalty
DB_NAME=loyalty
DB_SSL=false
# Alternatively provide a full connection string (takes precedence):
# DATABASE_URL=postgres://loyalty:loyalty@localhost:5432/loyalty

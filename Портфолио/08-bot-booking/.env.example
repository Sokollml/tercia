# ============================================================
#  Telegram booking bot — environment configuration
#  Copy this file to `.env` and fill in the values.
# ============================================================

# --- Telegram -------------------------------------------------
# Bot token from @BotFather (https://t.me/BotFather)
BOT_TOKEN=123456:PUT-YOUR-TOKEN-HERE

# Telegram user ids that are treated as MASTERS (comma separated).
# Everyone else is a client. Find your id via @userinfobot.
MASTER_IDS=111111111

# --- Localization --------------------------------------------
# Timezone used to display slots/reminders (IANA name).
TZ=Europe/Moscow
# Default interface language until the user switches it: ru | en
DEFAULT_LANG=ru

# --- Run mode -------------------------------------------------
# polling  -> long polling, best for local development
# webhook  -> HTTP webhook, best for production
MODE=polling

# --- Webhook (used only when MODE=webhook) -------------------
# Public HTTPS base url where Telegram will send updates.
WEBHOOK_HOST=https://your-domain.example.com
# Path Telegram posts updates to.
WEBHOOK_PATH=/webhook
# Optional secret token; Telegram echoes it back for verification.
WEBHOOK_SECRET=change-me-secret
# Interface/port the internal aiohttp server binds to.
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080

# --- Database -------------------------------------------------
# sqlite   -> local file (no server needed)
# postgres -> production
DB_DRIVER=sqlite

# SQLite (when DB_DRIVER=sqlite)
SQLITE_PATH=booking.db

# PostgreSQL (when DB_DRIVER=postgres)
DB_HOST=localhost
DB_PORT=5432
DB_USER=booking
DB_PASSWORD=booking
DB_NAME=booking

# --- Rate limiting -------------------------------------------
# Max updates per user within RATE_WINDOW seconds.
RATE_LIMIT=5
RATE_WINDOW=3.0

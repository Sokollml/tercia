# ============================================================
#  .env.example  — скопируй в .env и заполни значениями
# ============================================================

# ---- Telegram userbot (collector) ----
# api_id / api_hash берём тут: https://my.telegram.org -> API development tools
TG_API_ID=1234567
TG_API_HASH=your_api_hash_here
# Телефон ОТДЕЛЬНОГО аккаунта (не основного!), в формате +79991234567
TG_PHONE=+70000000000
# Имя файла сессии Telethon (лежит в volume, НЕ в репозитории)
TG_SESSION=/data/session/collector.session

# ---- Telegram bot (mini-app) ----
# Токен бота от @BotFather. Нужен для валидации initData (HMAC) в API.
BOT_TOKEN=123456:ABC-DEF...
# Публичный URL фронта (Vercel), который открывается кнопкой mini-app
MINIAPP_URL=https://your-app.vercel.app

# ---- Postgres (тот же инстанс, что и n8n, или отдельная БД) ----
DB_HOST=postgres
DB_PORT=5432
DB_NAME=freelance_orders
DB_USER=freelance
DB_PASSWORD=change_me

# ---- LLM (для n8n AI Agent / OpenAI-совместимый эндпоинт) ----
LLM_API_KEY=sk-...
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ---- Collector runtime ----
# Как далеко назад тянуть историю при разовой выгрузке (export_history.py)
HISTORY_LIMIT=200
# Интервал опроса новых сообщений в live-режиме (сек)
POLL_INTERVAL=60

# ---- Validator microservice ----
VALIDATOR_PORT=8081
# Максимальный «возраст» initData в секундах (защита от replay)
INITDATA_MAX_AGE=86400

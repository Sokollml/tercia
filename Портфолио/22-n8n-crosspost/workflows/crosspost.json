            { "name": "access_token", "value": "PLACEHOLDER_VK_ACCESS_TOKEN" },
            { "name": "v", "value": "5.199" }
          ]
        },
        "options": {}
      },
      "id": "2859b73c-cbe0-4030-8d8f-dcd0915c00cc",
      "name": "Заготовка: VK wall.post",

      "typeVersion": 2,
      "position": [560, 320]
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHANNEL_ID || '@your_channel_placeholder' }}",
        "text": "={{ $json.text }}",
        "additionalFields": {

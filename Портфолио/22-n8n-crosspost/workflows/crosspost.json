        "options": {}
      },
      "id": "d45e269e-3ce2-4556-b30e-fdf5a89c24c2",
      "name": "Webhook приёма поста",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-220, 200],
      "webhookId": "d45e269e-3ce2-4556-b30e-fdf5a89c24c2"
    },
    {
      "parameters": {
        "updates": ["message"],
        "additionalFields": {}
      },
      "id": "fdf07d6a-5dc1-4cbf-8c41-a97e6743769d",
      "name": "Telegram бот-приёмник",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.2,
      "position": [-220, 440],
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_TELEGRAM_CRED_ID",
          "name": "Telegram Bot (приёмник)"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Нормализация входящего поста из вебформы (Webhook) ИЛИ из Telegram-бота.\n// Приводим к единой структуре очереди.\nconst body = $json.body || $json;\nconst tgMsg = $json.message || (body && body.message) || null;\n\n// Текст: из формы (body.text) или из телеграм-сообщения.\nlet text = '';\nif (body && typeof body.text === 'string') text = body.text;\nelse if (tgMsg && typeof tgMsg.text === 'string') text = tgMsg.text;\nelse if (tgMsg && typeof tgMsg.caption === 'string') text = tgMsg.caption;\ntext = (text || '').trim();\n\n// Медиа (упрощённо, для демо).\nlet media_url = (body && body.media_url) || null;\nlet media_type = (body && body.media_type) || null;\nif (!media_url && tgMsg && Array.isArray(tgMsg.photo) && tgMsg.photo.length) {\n  media_type = 'photo';\n  media_url = tgMsg.photo[tgMsg.photo.length - 1].file_id; // file_id, отдаётся Telegram\n}\n\n// Каналы-получатели. По умолчанию — только telegram.\nlet channels = (body && body.channels) || ['telegram'];\nif (typeof channels === 'string') channels = channels.split(',').map(s => s.trim()).filter(Boolean);\n\n// Время публикации. Если не задано — публикуем сейчас.\nconst now = new Date();\nlet publish_at = (body && body.publish_at) ? new Date(body.publish_at) : now;\nif (isNaN(publish_at.getTime())) publish_at = now;\nconst publish_now = publish_at.getTime() <= now.getTime();\n\n// Источник\nconst source = tgMsg ? 'telegram_bot' : 'webhook_form';\n\nif (!text && !media_url) {\n  throw new Error('Пустой пост: нет ни текста, ни медиа');\n}\n\nreturn {\n  json: {\n    text,\n    media_url,\n    media_type,\n    channels,\n    channels_json: JSON.stringify(channels),\n    publish_at: publish_at.toISOString(),\n    publish_now,\n    source\n  }\n};"
      },
      "id": "71b2b5ef-2b1f-4325-9468-4da8621529a9",
      "name": "Нормализация поста",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [40, 320]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO posts (text, media_url, media_type, channels, publish_at, status, source)\nVALUES ($1, $2, $3, $4::jsonb, $5::timestamptz, 'queued', $6)\nRETURNING id, text, media_url, media_type, channels, publish_at, status;",
        "options": {
          "queryReplacement": "={{ $json.text }},={{ $json.media_url }},={{ $json.media_type }},={{ $json.channels_json }},={{ $json.publish_at }},={{ $json.source }}"
        }
      },
      "id": "55c08750-d2f3-4cde-b6fe-6ddf16edf86d",
      "name": "Postgres INSERT в очередь",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [300, 320],
      "credentials": {
        "postgres": {
          "id": "REPLACE_POSTGRES_CRED_ID",
          "name": "Postgres (crosspost)"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "ca2e2dd1-c986-40bf-8851-76fb66378d1a",
              "leftValue": "={{ new Date($json.publish_at).getTime() <= Date.now() }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      },
      "id": "85dd7737-84ab-4715-979c-a46ebccecef6",
      "name": "Публиковать сейчас?",

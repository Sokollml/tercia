      "typeVersion": 4.2,
      "position": [820, 400],
      "disabled": true,
      "notes": "ЗАГОТОВКА. Подставьте owner_id и access_token сообщества VK. Аналогично добавляются OK/Dzen/X и т.д."
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE posts\nSET status = 'published', published_at = now(), result = $2::jsonb\nWHERE id = $1\nRETURNING id, status, published_at;",

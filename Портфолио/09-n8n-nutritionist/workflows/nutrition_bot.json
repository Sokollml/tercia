    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  count(*) AS entries,\n  COALESCE(sum(e.kcal), 0) AS kcal,\n  COALESCE(round(sum(e.protein_g)::numeric, 1), 0) AS protein_g,\n  COALESCE(round(sum(e.fat_g)::numeric, 1), 0) AS fat_g,\n  COALESCE(round(sum(e.carbs_g)::numeric, 1), 0) AS carbs_g\nFROM entries e\nJOIN users u ON u.id = e.user_id\nWHERE u.tg_user_id = $1\n  AND e.created_at::date = CURRENT_DATE;",
        "options": {
          "queryReplacement": "={{ $json.message.from.id }}"
        }
      },
      "id": "5e53ef69-8245-446e-b334-59aaea796c8c",

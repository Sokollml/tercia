        "text": "={{ '\\uD83D\\uDCC5 \\u0421\\u0435\\u0433\\u043E\\u0434\\u043D\\u044F\\n' +\n  '\\uD83C\\uDF7D \\u041F\\u0440\\u0438\\u0451\\u043C\\u043E\\u0432 \\u043F\\u0438\\u0449\\u0438: ' + $json.entries + '\\n' +\n  '\\uD83D\\uDD25 ' + $json.kcal + ' \\u043A\\u043A\\u0430\\u043B\\n' +\n  '\\uD83E\\uDD69 \\u0411: ' + $json.protein_g + ' \\u0433  \\uD83E\\uDDC8 \\u0416: ' + $json.fat_g + ' \\u0433  \\uD83C\\uDF5E \\u0423: ' + $json.carbs_g + ' \\u0433' }}",
        "additionalFields": {}

      "id": "9db75cf0-f68c-48d2-a5ba-84f065c17791",
      "name": "Switch Command",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [260, 300]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.message.text }}",
        "options": {
          "systemMessage": "=Ты — ассистент-нутрициолог. Оцени описанный приём пищи и верни СТРОГО валидный JSON без markdown, без пояснений, без ```-обёрток.\n\nФормат ответа (ровно эти ключи):\n{\n  \"dish\": \"краткое название блюда\",\n  \"kcal\": <целое число, ккал>,\n  \"protein_g\": <число, белки в граммах>,\n  \"fat_g\": <число, жиры в граммах>,\n  \"carbs_g\": <число, углеводы в граммах>,\n  \"confidence\": <число от 0 до 1>,\n  \"note\": \"короткий комментарий на языке пользователя (RU/EN)\"\n}\n\nПравила:\n- Если порция не указана — предполагай стандартную порцию и отметь это в note.\n- Никогда не добавляй текст вне JSON.\n- Числа — без единиц измерения внутри значений.\n- Определи язык пользователя (русский или английский) и пиши dish/note на нём.\n- Если это не еда — верни kcal=0 и note с просьбой описать приём пищи."
        }
      },
      "id": "3624c9d1-a7f1-4f0d-b2f5-d0188b9431e3",
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [520, 460]
    },
    {
      "parameters": {
        "model": "gpt-4o-mini",
        "options": {
          "temperature": 0.2
        }
      },
      "id": "adf89ac9-32b7-4c29-99e2-d442dcfa7b21",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1,
      "position": [520, 660],
      "credentials": {
        "openAiApi": {
          "id": "REPLACE_OPENAI_CRED_ID",
          "name": "OpenAI Nutrition"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Парсинг и валидация JSON от LLM с fallback на мусор.\n// Дневной лимит для демо проверяется отдельно в Postgres,\n// здесь — нормализация ответа AI Agent.\n\nconst DAILY_LIMIT = 30; // лимит записей в день на пользователя (демо)\n\nconst item = $input.first();\nconst raw = (item.json.output ?? item.json.text ?? '').toString();\n\n// Данные пользователя из Telegram Trigger\nconst tg = $('Telegram Trigger').first().json;\nconst msg = tg.message || {};\nconst from = msg.from || {};\nconst chatId = (msg.chat && msg.chat.id) || from.id;\nconst userId = from.id;\nconst username = from.username || '';\nconst firstName = from.first_name || '';\nconst userText = msg.text || '';\n\nfunction extractJson(s) {\n  // Убираем markdown-обёртки ```json ... ```\n  let t = s.trim();\n  t = t.replace(/^```(?:json)?/i, '').replace(/```$/, '').trim();\n  // Пытаемся выдернуть первый {...} блок\n  const start = t.indexOf('{');\n  const end = t.lastIndexOf('}');\n  if (start !== -1 && end !== -1 && end > start) {\n    t = t.slice(start, end + 1);\n  }\n  return t;\n}\n\nfunction toNum(v, def = 0) {\n  const n = Number(v);\n  return Number.isFinite(n) ? n : def;\n}\n\nlet parsed = null;\nlet ok = false;\ntry {\n  parsed = JSON.parse(extractJson(raw));\n  if (parsed && typeof parsed === 'object') ok = true;\n} catch (e) {\n  ok = false;\n}\n\nlet result;\nif (ok) {\n  result = {\n    valid: true,\n    dish: (parsed.dish || 'Приём пищи').toString().slice(0, 200),\n    kcal: Math.max(0, Math.round(toNum(parsed.kcal))),\n    protein_g: Math.max(0, toNum(parsed.protein_g)),\n    fat_g: Math.max(0, toNum(parsed.fat_g)),\n    carbs_g: Math.max(0, toNum(parsed.carbs_g)),\n    confidence: Math.min(1, Math.max(0, toNum(parsed.confidence, 0.5))),\n    note: (parsed.note || '').toString().slice(0, 500)\n  };\n} else {\n  // Fallback на мусорный ответ LLM\n  result = {\n    valid: false,\n    dish: 'Не распознано',\n    kcal: 0,\n    protein_g: 0,\n    fat_g: 0,\n    carbs_g: 0,\n    confidence: 0,\n    note: 'Не удалось разобрать ответ. Опишите приём пищи текстом, например: «овсянка на молоке 200 г и банан».'\n  };\n}\n\nreturn [{\n  json: {\n    ...result,\n    daily_limit: DAILY_LIMIT,\n    user_id: userId,\n    username,\n    first_name: firstName,\n    chat_id: chatId,\n    raw_text: userText,\n    raw_llm: raw\n  }\n}];\n"
      },
      "id": "57f3b87a-92f8-4287-ae03-f3b6cd0e4978",
      "name": "Parse & Validate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [780, 460]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH u AS (\n  INSERT INTO users (tg_user_id, username, first_name)\n  VALUES ($1, $2, $3)\n  ON CONFLICT (tg_user_id) DO UPDATE\n    SET username = EXCLUDED.username,\n        first_name = EXCLUDED.first_name\n  RETURNING id\n),\ncnt AS (\n  SELECT count(*) AS c\n  FROM entries e\n  JOIN users us ON us.id = e.user_id\n  WHERE us.tg_user_id = $1\n    AND e.created_at::date = CURRENT_DATE\n),\nins AS (\n  INSERT INTO entries (user_id, dish, kcal, protein_g, fat_g, carbs_g, confidence, note, raw_text)\n  SELECT u.id, $4, $5, $6, $7, $8, $9, $10, $11\n  FROM u, cnt\n  WHERE cnt.c < $12 AND $13 = true\n  RETURNING id\n)\nSELECT\n  (SELECT c FROM cnt) AS today_count,\n  $12 AS daily_limit,\n  (SELECT id FROM ins) AS inserted_id,\n  ((SELECT c FROM cnt) >= $12) AS limit_reached;",
        "options": {
          "queryReplacement": "={{ $json.user_id }},={{ $json.username }},={{ $json.first_name }},={{ $json.dish }},={{ $json.kcal }},={{ $json.protein_g }},={{ $json.fat_g }},={{ $json.carbs_g }},={{ $json.confidence }},={{ $json.note }},={{ $json.raw_text }},={{ $json.daily_limit }},={{ $json.valid }}"
        }
      },
      "id": "d502f5fd-0dee-4d33-95a4-adfca9376dec",
      "name": "Insert Entry",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [1040, 460],
      "credentials": {
        "postgres": {
          "id": "REPLACE_POSTGRES_CRED_ID",
          "name": "Postgres Nutrition"
        }
      }
    },
    {
      "parameters": {
        "chatId": "={{ $('Parse & Validate').first().json.chat_id }}",
        "text": "={{ (() => {\n  const p = $('Parse & Validate').first().json;\n  const db = $json;\n  if (db && db.limit_reached && !db.inserted_id) {\n    return '\\u26A0\\uFE0F \\u0414\\u043D\\u0435\\u0432\\u043D\\u043E\\u0439 \\u043B\\u0438\\u043C\\u0438\\u0442 \\u0434\\u0435\\u043C\\u043E \\u0434\\u043E\\u0441\\u0442\\u0438\\u0433\\u043D\\u0443\\u0442 (' + db.daily_limit + ' \\u0437\\u0430\\u043F\\u0438\\u0441\\u0435\\u0439/\\u0434\\u0435\\u043D\\u044C). \\u041F\\u043E\\u043F\\u0440\\u043E\\u0431\\u0443\\u0439\\u0442\\u0435 \\u0437\\u0430\\u0432\\u0442\\u0440\\u0430.';\n  }\n  if (!p.valid) {\n    return '\\uD83E\\uDD14 ' + p.note;\n  }\n  return '\\uD83C\\uDF7D \\u0420\\u0430\\u0437\\u0431\\u043E\\u0440: ' + p.dish + '\\n' +\n    '\\uD83D\\uDD25 ' + p.kcal + ' \\u043A\\u043A\\u0430\\u043B\\n' +\n    '\\uD83E\\uDD69 \\u0411: ' + p.protein_g + ' \\u0433  \\uD83E\\uDDC8 \\u0416: ' + p.fat_g + ' \\u0433  \\uD83C\\uDF5E \\u0423: ' + p.carbs_g + ' \\u0433\\n' +\n    (p.note ? ('\\uD83D\\uDCDD ' + p.note + '\\n') : '') +\n    '\\u2705 \\u0417\\u0430\\u043F\\u0438\\u0441\\u0430\\u043D\\u043E (' + (db.today_count + 1) + '/' + db.daily_limit + ' \\u0441\\u0435\\u0433\\u043E\\u0434\\u043D\\u044F)';\n})() }}",
        "additionalFields": {}
      },
      "id": "76700881-d722-401a-8a97-b7a545efed6d",
      "name": "Reply Food",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1300, 460],
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_TELEGRAM_CRED_ID",
          "name": "Telegram Nutrition Bot"
        }

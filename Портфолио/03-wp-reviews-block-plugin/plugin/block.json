{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "reviews-block/testimonials",
	"version": "1.0.0",
	"title": "Отзывы (Reviews)",
	"category": "widgets",
	"icon": "format-quote",
	"description": "Выводит отзывы (testimonials) каруселью или сеткой. Renders testimonials as a carousel or grid.",
	"keywords": ["отзывы", "testimonials", "reviews", "carousel", "карусель"],
	"textdomain": "reviews-block",
	"supports": {
		"html": false,
		"align": ["wide", "full"],
		"anchor": true,
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"attributes": {
		"count": {
			"type": "number",
			"default": 6
		},
		"layout": {
			"type": "string",
			"default": "carousel",
			"enum": ["carousel", "grid"]
		},
		"autoplay": {
			"type": "boolean",
			"default": true
		},
		"interval": {
			"type": "number",
			"default": 5000
		}
	},
	"editorScript": "file:./assets/editor.js",
	"editorStyle": "file:./assets/editor.css",
	"style": "file:./assets/frontend.css",
	"viewScript": "file:./assets/frontend.js"
}

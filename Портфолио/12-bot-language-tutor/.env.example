# ---- Telegram ------------------------------------------------------------
# Get a token from @BotFather.
BOT_TOKEN=123456:REPLACE_ME

# Interface default and timezone (used for the daily-quota reset & reminders).
DEFAULT_LANG=ru
TZ=Europe/Moscow

# ---- Database ------------------------------------------------------------
# DB_DRIVER = sqlite (local dev) | postgres (production).
DB_DRIVER=sqlite

# SQLite (only used when DB_DRIVER=sqlite):
SQLITE_PATH=tutor.db

# PostgreSQL (only used when DB_DRIVER=postgres):
DB_HOST=localhost
DB_PORT=5432
DB_USER=tutor
DB_PASSWORD=tutor
DB_NAME=tutor

# ---- LLM (OpenAI-compatible /chat/completions) --------------------------
LLM_API_KEY=sk-REPLACE_ME
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=30

# ---- Limits & logging ----------------------------------------------------
# Free-tier: max LLM corrections per user per day.
FREE_DAILY_LIMIT=30
# Rate limit: at most RATE_LIMIT messages per RATE_WINDOW seconds per user.
RATE_LIMIT=5
RATE_WINDOW=3
LOG_LEVEL=INFO

{
  "name": "20 · Daily Digest (сводка заявок 09:00 МСК)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 0 9 * * *"
            }
          ]
        }
      },
      "id": "83414d51-664b-46b1-b786-7066ee4591e9",
      "name": "Расписание: 09:00 МСК",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, type, name, contact, summary, budget, source, is_spam, fallback, received_at\nFROM leads\nWHERE received_at >= (now() AT TIME ZONE 'Europe/Moscow')::date\n  AND received_at <  ((now() AT TIME ZONE 'Europe/Moscow')::date + INTERVAL '1 day')\nORDER BY received_at DESC;",
        "options": {}
      },
      "id": "e952dbb2-dba0-4c6b-b2a7-1aaa803cb5cc",
      "name": "Postgres: Заявки за день",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        460,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "REPLACE_PG_CRED_ID",
          "name": "Postgres VPS"
        }
      }
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Заявки за сутки (JSON-массив):\n{{ JSON.stringify($input.all().map(i => i.json)) }}",
        "options": {
          "systemMessage": "Ты — ассистент, который делает ежедневную сводку по заявкам для владельца бизнеса.\nНа вход придёт JSON-массив заявок за сутки. Сделай короткую деловую сводку на русском:\n1) Всего заявок, из них лидов / вопросов / спама / на ручную проверку.\n2) 3-5 самых важных лидов (имя, контакт, суть, бюджет).\n3) Одна строка-рекомендация: на что обратить внимание сегодня.\nПиши компактно, без воды, используй маркеры. Не выдумывай данные, которых нет."
        }
      },
      "id": "8f5c970b-b046-4256-9f2a-6eb3f7697a89",
      "name": "AI Агент: Сводка",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list",
          "cachedResultName": "gpt-4o-mini"
        },
        "options": {

# ---------------------------------------------------------------------------
# Copy this file to .env and fill in the values. Never commit your real .env.
# ---------------------------------------------------------------------------

# Telegram bot token from @BotFather (required).
BOT_TOKEN=123456:ABC-DEF_your_token_here

# Comma-separated Telegram user IDs allowed to run admin commands.
# Find your id via @userinfobot.
ADMIN_IDS=111111111,222222222

# Default UI language when a chat has not chosen one: ru or en.
DEFAULT_LANG=ru

# Timezone used by the scheduler (IANA name).
TZ=Europe/Moscow

# --- Database -------------------------------------------------------------
# DB_ENGINE=sqlite uses a local file (great for development).
# DB_ENGINE=postgres uses the DB_* settings below (recommended for production).
DB_ENGINE=sqlite
SQLITE_PATH=data/quiz.db

DB_HOST=localhost
DB_PORT=5432
DB_NAME=quizbot
DB_USER=quizbot
DB_PASSWORD=quizbot

# --- Scheduled daily question --------------------------------------------
# When the daily question is posted (in TZ above) to chats with /daily on.
DAILY_CRON_HOUR=12
DAILY_CRON_MINUTE=0

# --- Gameplay tuning ------------------------------------------------------
BASE_POINTS=10
SPEED_BONUS_MAX=5          # extra points for answering instantly (0 disables)
SPEED_WINDOW_SECONDS=60    # bonus decays to 0 across this window
POLL_OPEN_SECONDS=60       # how long a quiz poll stays open (5..600)
MARATHON_SIZE=5
MARATHON_GAP_SECONDS=20
BLITZ_SIZE=5
BLITZ_GAP_SECONDS=8

# --- Misc -----------------------------------------------------------------
RATE_LIMIT_SECONDS=1.0     # min seconds between commands per user
LOG_LEVEL=INFO

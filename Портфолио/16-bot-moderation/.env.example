# ---- Telegram ----
# Токен бота от @BotFather (обязательно).
BOT_TOKEN=123456:ABC-DEF...
# Глобальные владельцы бота (через запятую), помимо админов чата.
ADMIN_IDS=

# ---- Локализация / время ----
DEFAULT_LANG=ru
TZ=Europe/Moscow

# ---- База данных ----
# sqlite (локально) или postgres (продакшн).
DB_DRIVER=sqlite
SQLITE_PATH=moderation.db
# Используется только при DB_DRIVER=postgres:
DB_HOST=localhost
DB_PORT=5432
DB_USER=moderation
DB_PASSWORD=moderation
DB_NAME=moderation

# ---- Модерация (значения по умолчанию для новых чатов) ----
CAPTCHA_TIMEOUT=60      # секунд на решение капчи, иначе кик
WARN_LIMIT=3            # число активных варнов до авто-мута
MUTE_DURATION=3600      # длительность авто-мута, секунды
ANTIFLOOD_LIMIT=5       # сообщений ...
ANTIFLOOD_WINDOW=5      # ... за столько секунд -> мут за флуд

# ---- Rate limit самого бота (на пользователя) ----
RATE_LIMIT=5
RATE_WINDOW=3.0

# ---- Логирование ----
LOG_LEVEL=INFO
